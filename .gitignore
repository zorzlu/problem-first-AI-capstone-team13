# Python envs and caches
backend/.venv/
backend/venv/
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Node/React dependencies and builds
frontend/node_modules/
frontend/dist/
frontend/build/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local environment configuration
backend/.env
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and Editor configs (keeping launch.json and tasks.json for sharing, ignoring user specific)
.vscode/tasks.log
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store

# Arize Phoenix local database & traces
.phoenix/
phoenix.db
backend/state/*.log
backend/state/fastembed_cache/
backend/state/*.log
backend/state/eval_runs/
backend/state/settings.json

# Mutable per-run state. The app self-seeds these on first boot from
# backend/seed_data.py (EXPOSURE_GRAPH) and the DEFAULT_WATCHLIST, so they should not be
# committed — a committed copy ships one machine's run as repo "truth" and dirties the
# tree on every run. (Already-tracked copies must be untracked once: see README.)
backend/state/graph.json
backend/state/run_results.json
backend/state/watchlist.json
backend/state/routing_overrides.json
