# Frontend environment configuration.
#
# Local dev normally uses relative /api calls plus the Vite dev-server proxy.
# Set VITE_API_BASE_URL only when the built frontend is served from a different
# origin than the backend API.
VITE_API_BASE_URL=

# Vite dev-server proxy target for local development.
VITE_API_PROXY_TARGET=http://localhost:8000
