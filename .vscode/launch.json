{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "windows": {
        "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe"
      },
      "osx": {
        "python": "${workspaceFolder}/backend/.venv/bin/python"
      },
      "linux": {
        "python": "${workspaceFolder}/backend/.venv/bin/python"
      },
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Backend: Run Unit Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.run_tests",
      "windows": {
        "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe"
      },
      "osx": {
        "python": "${workspaceFolder}/backend/.venv/bin/python"
      },
      "linux": {
        "python": "${workspaceFolder}/backend/.venv/bin/python"
      },
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Frontend: Vite React Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "Tracing: Arize Phoenix Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "./backend/.venv/Scripts/python.exe ./backend/run_phoenix.py serve",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PHOENIX_HOST": "127.0.0.1"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Application (Backend + Frontend + Tracing)",
      "configurations": [
        "Backend: FastAPI Server",
        "Frontend: Vite React Server",
        "Tracing: Arize Phoenix Server"
      ],
      "stopAll": false
    }
  ]
}
