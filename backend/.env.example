# ============================================================
# Cross-Impact Catalyst Briefings — Environment Configuration
# ============================================================
# Copy this file to backend/.env and fill in the values below.
# All keys are optional. See README.md for details on each key
# and links to sign up for free tiers.
#
# Minimum setup for real LLM synthesis:
#   Set one supported provider credential, such as GEMINI_API_KEY or OPENAI_API_KEY.
#
# No keys? The app runs in no-key / mock mode using rules-based
# synthesis. All three replay scenarios still work fully.
# ============================================================


# ------------------------------------------------------------
# LLM Provider Selection and Overrides
# ------------------------------------------------------------
# backend/llm.py owns the per-step route map:
#   extraction/synthesis/judge: Gemini primary, OpenAI fallback
#   graph_expansion: OpenAI primary, Gemini fallback
#
# Optional per-step overrides:
#   EXTRACTION_LLM_PROVIDER=anthropic
#   EXTRACTION_LLM_MODEL=claude-3-5-haiku-20241022
#   SYNTHESIS_LLM_PROVIDER=openai
#   SYNTHESIS_LLM_MODEL=gpt-4o-mini
#   JUDGE_LLM_PROVIDER=gemini
#   JUDGE_LLM_MODEL=gemini-2.5-flash-lite
#   GRAPH_EXPANSION_LLM_PROVIDER=local
#   GRAPH_EXPANSION_LLM_MODEL=llama3.1
#
# Supported providers:
#   openai | gemini | anthropic | openai_compatible | local
#
# Optional legacy global override. New configs should prefer the explicit
# per-step variables above.
# LLM_PROVIDER=


# ------------------------------------------------------------
# Google Gemini API Key  (default LLM)
# ------------------------------------------------------------
# Used by default for: extraction, synthesis, judge
# Catalyst dedup runs locally (fastembed) — no embedding API, no per-call cost.
#
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=


# ------------------------------------------------------------
# OpenAI API Key  (alternative LLM)
# ------------------------------------------------------------
# Used by default for: graph expansion, and as fallback for extraction/synthesis/judge
# Catalyst dedup runs locally (fastembed) — no embedding API, no per-call cost.
#
# Requires a funded account. All replay scenarios cost < $0.10.
#
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=


# ------------------------------------------------------------
# Anthropic Claude API Key  (optional LLM provider)
# ------------------------------------------------------------
# Activate per step with e.g. SYNTHESIS_LLM_PROVIDER=anthropic and
# SYNTHESIS_LLM_MODEL=claude-sonnet-4-20250514.
ANTHROPIC_API_KEY=


# ------------------------------------------------------------
# Hosted OpenAI-Compatible Endpoint  (optional LLM provider)
# ------------------------------------------------------------
# For hosted gateways that expose an OpenAI-compatible chat API.
# Activate with e.g. SYNTHESIS_LLM_PROVIDER=openai_compatible.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=


# ------------------------------------------------------------
# Local OpenAI-Compatible Endpoint  (optional LLM provider)
# ------------------------------------------------------------
# For local servers such as Ollama /v1, LM Studio, or vLLM when they expose an
# OpenAI-compatible API. Activate with e.g. GRAPH_EXPANSION_LLM_PROVIDER=local.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=


# ------------------------------------------------------------
# Catalyst Dedup Embedding Model  (local, optional override)
# ------------------------------------------------------------
# Near-duplicate catalyst detection uses a LOCAL embedding model via fastembed
# (ONNX, CPU). It downloads once (~50 MB) then runs offline at $0/call — there is
# no remote embedding API. If the model cannot be loaded, the system automatically
# falls back to a deterministic lexical cosine matcher.
# Override the model name here if desired (default: BAAI/bge-small-en-v1.5, 384d).
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=backend/state/fastembed_cache


# ------------------------------------------------------------
# Finnhub API Key  (live direct company news)
# ------------------------------------------------------------
# Used for: fetching real-time company-specific news articles
#           when scenario_id=live (Live Feeds mode).
# Not required for any of the three replay scenarios.
#
# Free tier: 60 API calls/minute — sufficient for this demo.
# Get a free key at: https://finnhub.io
FINNHUB_API_KEY=


# ------------------------------------------------------------
# Currents API Key  (live cross-impact / geopolitical news)
# ------------------------------------------------------------
# Used for: fetching broad external news in Live Feeds mode
#           with Iteration 3 (cross-impact routing).
# Not required for any of the three replay scenarios.
#
# Free tier available.
# Get a free key at: https://currentsapi.services/en/register
CURRENTS_API_KEY=


# ------------------------------------------------------------
# Arize Phoenix Tracing Configuration
# ------------------------------------------------------------
# Phoenix collects OpenTelemetry traces from LangGraph runs.
# The dashboard is accessible at http://localhost:<PHOENIX_PORT>
# after starting the Phoenix server process.
PHOENIX_PROJECT_NAME=cross-impact-catalysts
PHOENIX_PORT=6006


# ------------------------------------------------------------
# Freshness Filter
# ------------------------------------------------------------
# How many minutes back from "now" to accept articles in live
# mode. Articles older than this window are filtered out.
# Replay scenarios bypass this filter entirely.
FRESHNESS_LOOKBACK_MINUTES=10
